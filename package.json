{
  "name": "pi-permission-explain",
  "version": "0.1.0",
  "description": "On-demand plain-English explanations for pi-permission-system prompts",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "permissions",
    "pi-permission-system",
    "explain"
  ],
  "license": "MIT",
  "author": "rkshrksh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkshrksh/pi-permission-explain.git"
  },
  "homepage": "https://github.com/rkshrksh/pi-permission-explain#readme",
  "bugs": {
    "url": "https://github.com/rkshrksh/pi-permission-explain/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "files": [
    "src",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "selfcheck": "PERMISSION_EXPLAIN_SELFCHECK=1 pi -e ./src/index.ts --help"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
